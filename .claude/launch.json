{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/Hosts/TenantFlow.Api", "--launch-profile", "http"],
      "port": 5080
    },
    {
      "name": "worker",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/Hosts/TenantFlow.Worker", "--launch-profile", "http"],
      "port": 5081
    },
    {
      "name": "rabbitmq",
      "url": "http://localhost:15672",
      "port": 15672
    },
    {
      "name": "keycloak",
      "url": "http://localhost:8080",
      "port": 8080
    },
    {
      "name": "grafana",
      "url": "http://localhost:3000",
      "port": 3000
    }
  ]
}
