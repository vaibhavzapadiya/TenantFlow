<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Only nuget.org is trusted, and every package id must map to it.
    This blocks dependency-confusion attacks through machine-level feeds.
    If a private feed is added later, map its package prefixes explicitly.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
