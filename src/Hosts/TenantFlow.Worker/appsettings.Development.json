{
  "ConnectionStrings": {
    "TenantFlow": "Host=127.0.0.1;Port=55432;Database=tenantflow;Username=tenantflow_app;Password=tenantflow-app-local-only"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning",
      "Quartz": "Information"
    }
  },
  "Messaging": {
    "RabbitMq": {
      "Host": "localhost",
      "Port": 5672,
      "Username": "tenantflow",
      "Password": "tenantflow-rabbitmq-local-only"
    }
  },
  "Payments": {
    "Simulator": {
      "Enabled": true
    }
  },
  "Storage": {
    "Provider": "filesystem",
    "Root": "../../../.storage",
    "Filesystem": {
      "Enabled": true
    }
  }
}
