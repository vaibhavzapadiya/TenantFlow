<Project Sdk="Microsoft.NET.Sdk">

  <!-- Payments module persistence and provider adapters. Owns the PostgreSQL schema "payments" (ADR-0012, ADR-0022). -->
  <PropertyGroup>
    <RootNamespace>TenantFlow.Payments.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The provider adapters are internal; their unit tests drive them over a fake HTTP handler. -->
    <InternalsVisibleTo Include="TenantFlow.Payments.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Design-time only (dotnet ef migrations); never flows to the hosts. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\TenantFlow.BuildingBlocks.Abstractions\TenantFlow.BuildingBlocks.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\TenantFlow.BuildingBlocks.Messaging\TenantFlow.BuildingBlocks.Messaging.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\TenantFlow.BuildingBlocks.Persistence\TenantFlow.BuildingBlocks.Persistence.csproj" />
    <ProjectReference Include="..\TenantFlow.Payments.Application\TenantFlow.Payments.Application.csproj" />
    <ProjectReference Include="..\TenantFlow.Payments.Domain\TenantFlow.Payments.Domain.csproj" />
  </ItemGroup>

</Project>
