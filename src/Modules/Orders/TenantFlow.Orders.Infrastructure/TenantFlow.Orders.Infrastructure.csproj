  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\TenantFlow.BuildingBlocks.Abstractions\TenantFlow.BuildingBlocks.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\TenantFlow.BuildingBlocks.Messaging\TenantFlow.BuildingBlocks.Messaging.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\TenantFlow.BuildingBlocks.Persistence\TenantFlow.BuildingBlocks.Persistence.csproj" />
    <ProjectReference Include="..\TenantFlow.Orders.Application\TenantFlow.Orders.Application.csproj" />
    <ProjectReference Include="..\TenantFlow.Orders.Domain\TenantFlow.Orders.Domain.csproj" />
    <!-- Contract only: the product limits that size the order-line snapshot columns (ADR-0002). -->
    <ProjectReference Include="..\..\Catalog\TenantFlow.Catalog.Contracts\TenantFlow.Catalog.Contracts.csproj" />
  </ItemGroup>

</Project>
