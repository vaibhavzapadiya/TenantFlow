    <RootNamespace>TenantFlow.Operations.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Design-time only (dotnet ef migrations); never flows to the hosts. -->
