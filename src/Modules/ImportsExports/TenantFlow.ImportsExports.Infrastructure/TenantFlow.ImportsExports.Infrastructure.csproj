<Project Sdk="Microsoft.NET.Sdk">

  <!-- ImportsExports module persistence and the storage adapters (filesystem, S3). Owns the PostgreSQL schema "imports_exports" (ADR-0012, ADR-0024). -->
  <PropertyGroup>
    <RootNamespace>TenantFlow.ImportsExports.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The storage adapter is internal; its unit tests drive it on a temporary folder. -->
    <InternalsVisibleTo Include="TenantFlow.ImportsExports.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Design-time only (dotnet ef migrations); never flows to the hosts. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\TenantFlow.BuildingBlocks.Abstractions\TenantFlow.BuildingBlocks.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\TenantFlow.BuildingBlocks.Messaging\TenantFlow.BuildingBlocks.Messaging.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\TenantFlow.BuildingBlocks.Persistence\TenantFlow.BuildingBlocks.Persistence.csproj" />
    <ProjectReference Include="..\TenantFlow.ImportsExports.Application\TenantFlow.ImportsExports.Application.csproj" />
    <ProjectReference Include="..\TenantFlow.ImportsExports.Domain\TenantFlow.ImportsExports.Domain.csproj" />
    <ProjectReference Include="..\TenantFlow.ImportsExports.Contracts\TenantFlow.ImportsExports.Contracts.csproj" />
    <ProjectReference Include="..\..\Catalog\TenantFlow.Catalog.Contracts\TenantFlow.Catalog.Contracts.csproj" />
  </ItemGroup>

</Project>
