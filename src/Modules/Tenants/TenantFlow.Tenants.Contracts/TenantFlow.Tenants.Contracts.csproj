    consumer can never reach into the module.
  -->
  <PropertyGroup>
    <RootNamespace>TenantFlow.Tenants.Contracts</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\TenantFlow.BuildingBlocks.Abstractions\TenantFlow.BuildingBlocks.Abstractions.csproj" />
  </ItemGroup>

</Project>
