<Project Sdk="Microsoft.NET.Sdk">

  <!-- Catalog module persistence. Owns the PostgreSQL schema "catalog" (ADR-0012). -->
  <PropertyGroup>
    <RootNamespace>TenantFlow.Catalog.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Design-time only (dotnet ef migrations); never flows to the hosts. -->
