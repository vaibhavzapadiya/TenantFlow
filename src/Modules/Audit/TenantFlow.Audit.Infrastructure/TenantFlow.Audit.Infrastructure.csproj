<Project Sdk="Microsoft.NET.Sdk">

  <!-- Audit module persistence. Owns the PostgreSQL schema "audit" (ADR-0012, ADR-0026). -->
  <PropertyGroup>
    <RootNamespace>TenantFlow.Audit.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Design-time only (dotnet ef migrations); never flows to the hosts. -->
