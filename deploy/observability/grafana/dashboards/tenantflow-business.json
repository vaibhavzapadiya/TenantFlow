      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "expr": "sum by (provider, operation, outcome) (rate(tenantflow_payments_provider_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{provider}} {{operation}} {{outcome}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
