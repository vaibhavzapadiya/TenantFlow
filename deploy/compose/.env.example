# Optional overrides of TenantFlow's local settings (ADR-0008, ADR-0037). Nothing here is needed: compose.yaml holds
# every value below as its default. To change one, copy this file to deploy/compose/.env (git-ignored) and uncomment
# the line. These values are for a throwaway local stack only. Never put a real or shared credential here.
#
# The hosts' local settings (src/Hosts/*/appsettings.Development.json) use the defaults. After changing a port or a
# password the hosts use, override the same key in that host's user-secrets, for example:
#   dotnet user-secrets set ConnectionStrings:TenantFlow "<connection string>" --project src/Hosts/TenantFlow.Api
# Role passwords are re-applied by the provisioner on every "docker compose up"; POSTGRES_* only when the volume is created.
# Keycloak inserts KEYCLOAK_DEV_USER_PASSWORD into the realm JSON as it is: no " or \ in it.

# POSTGRES_DB=tenantflow
# POSTGRES_USER=tenantflow
# POSTGRES_PASSWORD=tenantflow-local-only
# 5432 is often taken by a natively installed PostgreSQL, so the container uses 55432 on the host.
# POSTGRES_PORT=55432
# The Migrator connects as the owner role, the hosts as the app role (ADR-0012).
# TENANTFLOW_OWNER_PASSWORD=tenantflow-owner-local-only
# TENANTFLOW_APP_PASSWORD=tenantflow-app-local-only

# Local Keycloak (ADR-0009). Admin console: http://localhost:8080/admin (user "admin").
# KEYCLOAK_PORT=8080
# KEYCLOAK_ADMIN_PASSWORD=tenantflow-local-only
# Password of the synthetic realm users (dev-user-a, dev-operator).
# KEYCLOAK_DEV_USER_PASSWORD=tenantflow-dev-user-local-only

# Local RabbitMQ (ADR-0021). Management UI: http://localhost:15672.
# RABBITMQ_USER=tenantflow
# RABBITMQ_PASSWORD=tenantflow-rabbitmq-local-only
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672

# Observability profile (docker compose --profile observability up -d). Grafana user is "admin".
# GRAFANA_ADMIN_PASSWORD=tenantflow-local-only
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090
# LOKI_PORT=3100
# TEMPO_PORT=3200
# ALERTMANAGER_PORT=9093
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318
