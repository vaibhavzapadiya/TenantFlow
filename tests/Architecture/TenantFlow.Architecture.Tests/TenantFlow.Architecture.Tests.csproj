<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Architecture tests (SPEC-0003 criterion 19; ADR-0002, ADR-0012): module boundaries and layer direction, read from
    the compiled assemblies' references, and each module's DbContext mapped only to its own schema. No host, no database.
  -->
  <PropertyGroup>
    <RootNamespace>TenantFlow.Architecture.Tests</RootNamespace>
    <!-- xUnit v3 test projects are self-hosting executables. -->
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- xUnit v4 no longer adds this implicitly. -->
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The hosts reference every module, so every module assembly is reachable from here. -->
    <ProjectReference Include="..\..\..\src\Hosts\TenantFlow.Api\TenantFlow.Api.csproj" />
    <ProjectReference Include="..\..\..\src\Hosts\TenantFlow.Migrator\TenantFlow.Migrator.csproj" />
    <!-- The exceptions register and the repository root, shared with tests/Security. -->
    <ProjectReference Include="..\..\Shared\TenantFlow.Testing\TenantFlow.Testing.csproj" />
    <Using Include="TenantFlow.Testing" />
  </ItemGroup>

</Project>
