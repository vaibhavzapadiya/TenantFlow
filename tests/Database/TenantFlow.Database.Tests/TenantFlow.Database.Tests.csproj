<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Database tests against the local Compose PostgreSQL (ADR-0012, SPEC-0002 criteria 1-4), and messaging tests
    against the local Compose RabbitMQ (ADR-0021).
    They need the local stack running ("docker compose up", see README) and read its settings the way Compose does
    (LocalStack); run them with "dotnet run" on this project in Release. IsTestProject is false so the default gate (dotnet test on the
    solution, as in CI) builds this project but does not run it.
  -->
  <PropertyGroup>
    <RootNamespace>TenantFlow.Database.Tests</RootNamespace>
    <!-- xUnit v3 test projects are self-hosting executables. -->
    <OutputType>Exe</OutputType>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- xUnit v4 no longer adds this implicitly. -->
    <Using Include="Xunit" />
    <!-- Shared database and API test support (Support/), used by every test folder. -->
    <Using Include="TenantFlow.Database.Tests.Support" />
    <Using Include="TenantFlow.Api.Tests.Support" />
    <Using Include="TenantFlow.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Hosts\TenantFlow.Migrator\TenantFlow.Migrator.csproj" />
    <ProjectReference Include="..\..\..\src\Hosts\TenantFlow.Api\TenantFlow.Api.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\IdentityAccess\TenantFlow.IdentityAccess.Application\TenantFlow.IdentityAccess.Application.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\IdentityAccess\TenantFlow.IdentityAccess.Domain\TenantFlow.IdentityAccess.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\IdentityAccess\TenantFlow.IdentityAccess.Infrastructure\TenantFlow.IdentityAccess.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Tenants\TenantFlow.Tenants.Application\TenantFlow.Tenants.Application.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Tenants\TenantFlow.Tenants.Infrastructure\TenantFlow.Tenants.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\BuildingBlocks\TenantFlow.BuildingBlocks.Messaging.RabbitMq\TenantFlow.BuildingBlocks.Messaging.RabbitMq.csproj" />
    <ProjectReference Include="..\..\..\src\BuildingBlocks\TenantFlow.BuildingBlocks.Persistence\TenantFlow.BuildingBlocks.Persistence.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Catalog\TenantFlow.Catalog.Infrastructure\TenantFlow.Catalog.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Inventory\TenantFlow.Inventory.Infrastructure\TenantFlow.Inventory.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Orders\TenantFlow.Orders.Infrastructure\TenantFlow.Orders.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Notifications\TenantFlow.Notifications.Infrastructure\TenantFlow.Notifications.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Payments\TenantFlow.Payments.Infrastructure\TenantFlow.Payments.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Subscriptions\TenantFlow.Subscriptions.Infrastructure\TenantFlow.Subscriptions.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\ImportsExports\TenantFlow.ImportsExports.Infrastructure\TenantFlow.ImportsExports.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Audit\TenantFlow.Audit.Infrastructure\TenantFlow.Audit.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Operations\TenantFlow.Operations.Infrastructure\TenantFlow.Operations.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\BuildingBlocks\TenantFlow.BuildingBlocks.Scheduling\TenantFlow.BuildingBlocks.Scheduling.csproj" />
    <ProjectReference Include="..\..\Shared\TenantFlow.Testing\TenantFlow.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One shared API test host and test issuer, linked rather than copied (.agents/rules/tests.md). -->
    <Compile Include="..\..\Api\TenantFlow.Api.Tests\Support\ApiFactory.cs" Link="Support\Api\ApiFactory.cs" />
    <Compile Include="..\..\Api\TenantFlow.Api.Tests\Support\TestIssuer.cs" Link="Support\Api\TestIssuer.cs" />
    <Compile Include="..\..\Api\TenantFlow.Api.Tests\Support\KestrelBodyLimit.cs" Link="Support\Api\KestrelBodyLimit.cs" />
  </ItemGroup>

</Project>
