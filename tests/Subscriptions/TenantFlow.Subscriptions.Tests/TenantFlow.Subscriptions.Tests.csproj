<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fast unit tests for the Subscriptions module's Domain and Application layers (blueprint section 15, layer 1):
    the subscription state table, billing periods and the input rules, with no host, no database and no network.
  -->
  <PropertyGroup>
    <RootNamespace>TenantFlow.Subscriptions.Tests</RootNamespace>
    <!-- xUnit v3 test projects are self-hosting executables. -->
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- xUnit v4 no longer adds this implicitly. -->
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Modules\Subscriptions\TenantFlow.Subscriptions.Application\TenantFlow.Subscriptions.Application.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Subscriptions\TenantFlow.Subscriptions.Domain\TenantFlow.Subscriptions.Domain.csproj" />
  </ItemGroup>

</Project>
