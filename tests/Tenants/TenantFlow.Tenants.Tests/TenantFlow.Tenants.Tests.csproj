<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fast unit tests for the Tenants module's Domain and Application layers (blueprint section 15, layer 1):
    invariants, state transitions, and validation rules, with no host and no database.
  -->
  <PropertyGroup>
    <RootNamespace>TenantFlow.Tenants.Tests</RootNamespace>
    <!-- xUnit v3 test projects are self-hosting executables. -->
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- xUnit v4 no longer adds this implicitly. -->
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Modules\Tenants\TenantFlow.Tenants.Application\TenantFlow.Tenants.Application.csproj" />
    <ProjectReference Include="..\..\..\src\Modules\Tenants\TenantFlow.Tenants.Domain\TenantFlow.Tenants.Domain.csproj" />
  </ItemGroup>

</Project>
