!Directory.Build.props
!Directory.Packages.props
!global.json
!nuget.config
!.editorconfig
!deploy/certs/
!deploy/keycloak/Dockerfile
!deploy/identity/realms/production/

# Local build output, even inside allowed folders.
**/bin/
**/obj/
